# Generate with: openssl rand -base64 32
SECRET_KEY=Rb5q8+6JQrhM+hDv7myPCpxqQ+G4VZsY+iIL/v4jM9Q=

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# App (Low-Ops application specification)
PORT=8000
METRICS_PORT=8001
APPLICATION_URL=http://localhost:8000

# PostgreSQL (Low-Ops application specification)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=low_ops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# S3-compatible storage (Low-Ops application specification)
# Bucket only, or bucket/path-prefix (e.g. apps-cinaq-dev-bucket/nextapp-dev)
# Endpoint may omit the protocol; https is assumed (http for localhost/minio).
# S3_ENDPOINT=http://localhost:9000
# Optional public URL for browser-accessible file links (defaults to S3_ENDPOINT)
# S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=low-ops-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# OpenTelemetry (optional, enabled by platform)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://opentelemetry-collector.lowops-monitoring:4318
# OTEL_SERVICE_NAME=low-ops-django-template

# Email (optional — verification emails are skipped when unset)
# RESEND_API_KEY=your-resend-api-key

# Django-only (not part of the Low-Ops application specification)
# DEBUG=true
# ALLOW_PUBLIC_SIGN_UP=true
# POSTGRES_PUBLISH_PORT=5433
